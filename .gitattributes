#
# .gitattributes
#

## GENERIC ##

*					text=auto


## SOURCE CODE ##

*.c					eol=lf diff=cpp
*.h					eol=lf diff=cpp
*.cpp				eol=lf diff=cpp


## SCRIPTS ##

Makefile			eol=lf
Makefile*			eol=lf
*.makefile			eol=lf
*.make				eol=lf
*.mk				eol=lf
*.py				eol=lf diff=python
*.sh				eol=lf
*.fish				eol=lf
CMakeLists.txt		eol=lf


## TEXT & MARKUP FILES ##

*.txt				eol=crlf
*.md				eol=crlf
*.mkdn				eol=crlf
*.markdown			eol=crlf
*.rst				eol=lf

